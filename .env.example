PORT=3000

# HSM_MODE=mock       -> software keys generated in-process, for local testing only (NOT secure, never use in production)
# HSM_MODE=cloudhsm   -> real AWS CloudHSM via PKCS#11; requires this app to run on the EC2 client instance
#                       with the CloudHSM Client SDK installed and the cluster already activated.
HSM_MODE=mock

# Only used when HSM_MODE=cloudhsm
# Path to the PKCS#11 shared library provided by the CloudHSM Client SDK
CLOUDHSM_PKCS11_LIB=/opt/cloudhsm/lib/libcloudhsm_pkcs11.so
# Login PIN in the format  username:password  (the Crypto User credentials)
CLOUDHSM_PIN=crypto_user:changeme

# EJBCA REST API - points at your real EJBCA CE server (reachable from wherever this app runs)
EJBCA_BASE_URL=https://localhost:8443/ejbca/ejbca-rest-api/v1
EJBCA_CLIENT_CERT_PATH=./certs/ejbca-client.pem
EJBCA_CLIENT_KEY_PATH=./certs/ejbca-client-key.pem
EJBCA_CA_CERT_PATH=./certs/ejbca-ca-chain.pem
# Set to 'true' only for local trial servers with a self-signed cert you fully trust; never in production.
EJBCA_TLS_INSECURE=false
# Set to 'true' if EJBCA server or client certificates use < 2048-bit keys (fixes "ee key too small" error in Node 18+)
EJBCA_TLS_ALLOW_WEAK_KEYS=true
EJBCA_DEFAULT_CA_NAME=DocSigning Issuing CA
EJBCA_DEFAULT_CERT_PROFILE=DocSigningProfile
EJBCA_DEFAULT_EE_PROFILE=DocSigningEEP